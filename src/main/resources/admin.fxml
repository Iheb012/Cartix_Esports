                                    <TableColumn fx:id="colScore" prefWidth="100" text="SCORE" />
                                    <TableColumn fx:id="colTeam2" prefWidth="140" text="TEAM 2" />
                                    <TableColumn fx:id="colMatchDate" prefWidth="130" text="DATE / TIME" />
                                    <TableColumn fx:id="colMatchStatus" prefWidth="100" text="STATUS" />
                                    <TableColumn fx:id="colMatchActions" prefWidth="160" text="ACTIONS" />
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #6b7394;" text="No matches found" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- ─── TEAMS PAGE ─── -->
                <ScrollPane fx:id="pageTeams" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox spacing="16" style="-fx-padding: 20 28 28 28; -fx-background-color: #08090f;">
                        <VBox style="-fx-background-color: #111524; -fx-border-color: rgba(255,255,255,0.06); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;">
                                <Label style="-fx-text-fill: #e8eaf6; -fx-font-size: 13; -fx-font-weight: bold;" text="Team Management" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onCreateTeam" style="-fx-background-color: #4d78ff; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand; -fx-border-width: 0;" text="+ Create Team" />
                            </HBox>
                            <TableView fx:id="teamsTable" prefHeight="600" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-table-cell-border-color: rgba(255,255,255,0.04);">
                                <columns>
                                    <TableColumn fx:id="colTeamRank" prefWidth="50" text="#" />
                                    <TableColumn fx:id="colTeamName" prefWidth="180" text="TEAM" />
                                    <TableColumn fx:id="colTeamGame" prefWidth="100" text="GAME" />
                                    <TableColumn fx:id="colTeamPlayers" prefWidth="90" text="PLAYERS" />
