                                <ComboBox fx:id="filterPlayerGame" onAction="#onFilterChange" promptText="All Games" style="-fx-background-color: #161a2e; -fx-text-fill: #e8eaf6; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-background-radius: 8;" />
                            </HBox>
                            <TableView fx:id="playersTable" prefHeight="600" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-table-cell-border-color: rgba(255,255,255,0.04);">
                                <columns>
                                    <TableColumn fx:id="colRank" prefWidth="50" text="#" />
