                <!-- ─── SPONSORS (même modèle que Événements · PremiumSponsorHub) ─── -->
                <ScrollPane fx:id="pageSponsorsHub" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox fx:id="sponsorsRootVBox" spacing="0" style="-fx-padding: 0; -fx-background-color: #08090f;" />
                </ScrollPane>

                <ScrollPane fx:id="pageEventsHub" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox fx:id="eventsRootVBox" spacing="0" style="-fx-padding: 0; -fx-background-color: #08090f;" />
                </ScrollPane>

                <!-- ─── SETTINGS PAGE ─── -->
                <ScrollPane fx:id="pageSettings" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox spacing="16" style="-fx-padding: 20 28 28 28; -fx-background-color: #08090f;">
                        <HBox alignment="TOP_LEFT" spacing="16">
                            <!-- Left settings menu -->
                            <VBox prefWidth="200" spacing="2" style="-fx-background-color: #111524; -fx-border-color: rgba(255,255,255,0.06); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;">
                                <Label style="-fx-text-fill: #4a5070; -fx-font-size: 9; -fx-letter-spacing: 2; -fx-padding: 4 8 8 8;" text="SETTINGS" />
                                <Label style="-fx-text-fill: white; -fx-font-size: 13; -fx-background-color: rgba(77,120,255,0.15); -fx-background-radius: 8; -fx-padding: 8 12; -fx-cursor: hand;" text="General" />
                                <Label style="-fx-text-fill: #6b7394; -fx-font-size: 13; -fx-padding: 8 12; -fx-cursor: hand;" text="Security" />
                                <Label style="-fx-text-fill: #6b7394; -fx-font-size: 13; -fx-padding: 8 12; -fx-cursor: hand;" text="Notifications" />
                                <Label style="-fx-text-fill: #6b7394; -fx-font-size: 13; -fx-padding: 8 12; -fx-cursor: hand;" text="API Keys" />
                                <Label style="-fx-text-fill: #6b7394; -fx-font-size: 13; -fx-padding: 8 12; -fx-cursor: hand;" text="Platform Rules" />
                                <Label style="-fx-text-fill: #6b7394; -fx-font-size: 13; -fx-padding: 8 12; -fx-cursor: hand;" text="Maintenance" />
                            </VBox>

                            <!-- Settings Form -->
                            <VBox spacing="14" style="-fx-background-color: #111524; -fx-border-color: rgba(255,255,255,0.06); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 24;" HBox.hgrow="ALWAYS">
                                <Label style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="General Settings" />
                                <Separator style="-fx-background-color: rgba(255,255,255,0.06);" />

                                <VBox spacing="6">
                                    <Label style="-fx-text-fill: #6b7394; -fx-font-size: 11;" text="Platform Name" />
                                    <TextField fx:id="settingPlatformName" style="-fx-background-color: #161a2e; -fx-text-fill: #e8eaf6; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-font-size: 13;" text="Cartix" />
                                </VBox>
                                <VBox spacing="6">
                                    <Label style="-fx-text-fill: #6b7394; -fx-font-size: 11;" text="Season Name" />
                                    <TextField fx:id="settingSeasonName" style="-fx-background-color: #161a2e; -fx-text-fill: #e8eaf6; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-font-size: 13;" text="Season 2025" />
                                </VBox>
                                <VBox spacing="6">
                                    <Label style="-fx-text-fill: #6b7394; -fx-font-size: 11;" text="Max Teams per Tournament" />
                                    <TextField fx:id="settingMaxTeams" style="-fx-background-color: #161a2e; -fx-text-fill: #e8eaf6; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 12; -fx-font-size: 13;" text="32" />
                                </VBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-text-fill: #6b7394; -fx-font-size: 12;" text="Maintenance Mode" />
                                    <CheckBox fx:id="settingMaintenance" style="-fx-text-fill: #e8eaf6;" />
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-text-fill: #6b7394; -fx-font-size: 12;" text="Allow New Registrations" />
                                    <CheckBox fx:id="settingRegistrations" selected="true" style="-fx-text-fill: #e8eaf6;" />
                                </HBox>
                                <Separator style="-fx-background-color: rgba(255,255,255,0.06);" />
                                <HBox spacing="10">
                                    <Button onAction="#onSaveSettings" style="-fx-background-color: #4d78ff; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-width: 0;" text="Save Changes" />
                                    <Button onAction="#onResetSettings" style="-fx-background-color: #161a2e; -fx-text-fill: #6b7394; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;" text="Reset to Default" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

            </StackPane>

            <!-- STATUS BAR -->
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #0d0f1a; -fx-border-color: rgba(255,255,255,0.06); -fx-border-width: 1 0 0 0; -fx-padding: 7 28;">
                <Label style="-fx-text-fill: #22d98a; -fx-font-size: 11;" text="● System Online" />
                <Label style="-fx-text-fill: #4a5070;" text="|" />
                <Label style="-fx-text-fill: #6b7394; -fx-font-size: 11;" text="DB: Connected" />
                <Label style="-fx-text-fill: #4a5070;" text="|" />
                <Label fx:id="statusLabel" style="-fx-text-fill: #6b7394; -fx-font-size: 11;" text="Ready" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="clockLabel" style="-fx-text-fill: #6b7394; -fx-font-size: 11;" text="08/05/2026 · 00:00" />
                <Label style="-fx-text-fill: #4a5070; -fx-font-size: 11;" text="v2.5.0" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
