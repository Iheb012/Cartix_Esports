                                <Label style="-fx-text-fill: #ff4d6d; -fx-font-size: 12;" text="5 pending" />
                            </HBox>
                            <TableView fx:id="moderationTable" prefHeight="600" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-table-cell-border-color: rgba(255,255,255,0.04);">
                                <columns>
                                    <TableColumn fx:id="colRepId" prefWidth="50" text="#" />
                                    <TableColumn fx:id="colRepType" prefWidth="120" text="TYPE" />
                                    <TableColumn fx:id="colRepTarget" prefWidth="160" text="TARGET" />
                                    <TableColumn fx:id="colRepReporter" prefWidth="160" text="REPORTER" />
                                    <TableColumn fx:id="colRepReason" prefWidth="220" text="REASON" />
                                    <TableColumn fx:id="colRepDate" prefWidth="120" text="DATE" />
                                    <TableColumn fx:id="colRepSeverity" prefWidth="100" text="SEVERITY" />
                                    <TableColumn fx:id="colRepActions" prefWidth="180" text="ACTIONS" />
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #6b7394;" text="No reports pending" />
                                </placeholder>
                            </TableView>
                        </VBox>
