                                    <TableColumn fx:id="colTeamStatus" prefWidth="100" text="STATUS" />
                                    <TableColumn fx:id="colTeamActions" prefWidth="160" text="ACTIONS" />
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #6b7394;" text="No teams found" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- ─── TOURNAMENTS PAGE ─── -->
                <ScrollPane fx:id="pageTournaments" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox spacing="16" style="-fx-padding: 20 28 28 28; -fx-background-color: #08090f;">
                        <VBox style="-fx-background-color: #111524; -fx-border-color: rgba(255,255,255,0.06); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;">
                                <Label style="-fx-text-fill: #e8eaf6; -fx-font-size: 13; -fx-font-weight: bold;" text="Tournament Management" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onCreateTournament" style="-fx-background-color: #4d78ff; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 6 12; -fx-cursor: hand; -fx-border-width: 0;" text="+ Host Tournament" />
                            </HBox>
                            <TableView fx:id="tournamentsTable" prefHeight="600" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-table-cell-border-color: rgba(255,255,255,0.04);">
                                <columns>
                                    <TableColumn fx:id="colTournId" prefWidth="50" text="#" />
                                    <TableColumn fx:id="colTournName" prefWidth="200" text="TOURNAMENT" />
                                    <TableColumn fx:id="colTournGame" prefWidth="100" text="GAME" />
                                    <TableColumn fx:id="colTournTeams" prefWidth="80" text="TEAMS" />
                                    <TableColumn fx:id="colTournPrize" prefWidth="120" text="PRIZE POOL" />
                                    <TableColumn fx:id="colTournDate" prefWidth="120" text="START DATE" />
                                    <TableColumn fx:id="colTournStatus" prefWidth="100" text="STATUS" />
                                    <TableColumn fx:id="colTournActions" prefWidth="180" text="ACTIONS" />
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #6b7394;" text="No tournaments found" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- ─── MODERATION PAGE ─── -->
                <ScrollPane fx:id="pageModeration" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox fx:id="moderationRootVBox" spacing="16" style="-fx-padding: 20 28 28 28; -fx-background-color: #08090f;">
                        <VBox style="-fx-background-color: #111524; -fx-border-color: rgba(255,77,109,0.2); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;">
                                <Label style="-fx-text-fill: #e8eaf6; -fx-font-size: 13; -fx-font-weight: bold;" text="🛡  Moderation Queue" />
