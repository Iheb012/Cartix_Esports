                            </HBox>
                            <TableView fx:id="matchesTable" prefHeight="400" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-table-cell-border-color: rgba(255,255,255,0.04);">
                                <columns>
                                    <TableColumn fx:id="colMatchId" prefWidth="60" text="ID" />
                                    <TableColumn fx:id="colMatchGame" prefWidth="100" text="GAME" />
