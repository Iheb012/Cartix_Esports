                                    <TableColumn fx:id="colRating" prefWidth="90" text="RATING" />
                                    <TableColumn fx:id="colPlayerStatus" prefWidth="90" text="STATUS" />
                                    <TableColumn fx:id="colPlayerActions" prefWidth="140" text="ACTIONS" />
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #6b7394;" text="No players found" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <!-- ─── MATCHES PAGE ─── -->
                <ScrollPane fx:id="pageMatches" fitToWidth="true" managed="false" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-width: 0;" visible="false">
                    <VBox spacing="16" style="-fx-padding: 20 28 28 28; -fx-background-color: #08090f;">

                        <!-- Live Matches -->
                        <VBox style="-fx-background-color: #111524; -fx-border-color: rgba(255,59,92,0.15); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">
                            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 14 0;">
                                <Label style="-fx-text-fill: #e8eaf6; -fx-font-size: 13; -fx-font-weight: bold;" text="Live Matches" />
                                <Label style="-fx-text-fill: #ff3b5c; -fx-font-size: 9; -fx-font-weight: bold; -fx-background-color: rgba(255,59,92,0.12); -fx-padding: 3 7; -fx-background-radius: 10;" text="● LIVE 2" />
                            </HBox>
                            <VBox fx:id="liveMatchesList" spacing="10" />
                        </VBox>

                        <!-- All Matches Table -->
                        <VBox style="-fx-background-color: #111524; -fx-border-color: rgba(255,255,255,0.06); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;">
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;">
                                <Label style="-fx-text-fill: #e8eaf6; -fx-font-size: 13; -fx-font-weight: bold;" text="All Matches" />
