<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminCommunityController"
      prefHeight="960.0" prefWidth="1280.0"
      style="-fx-background-color: #0d1117;">

    <!-- ═══════════════════════════ -->
    <!-- SIDEBAR NAVIGATION GAUCHE  -->
    <!-- ═══════════════════════════ -->
    <VBox prefWidth="220"
          prefHeight="960"
          maxHeight="Infinity"
          style="-fx-background-color: #161b22;
                 -fx-border-color: #30363d;
                 -fx-border-width: 0 1 0 0;">

        <!-- LOGO / APP NAME -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 22 16 22 16;
                     -fx-border-color: #30363d;
                     -fx-border-width: 0 0 1 0;">
            <Label text="🏆 CartixeSports"
                   style="-fx-text-fill: #1f6feb;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <!-- OVERVIEW SECTION -->
        <VBox spacing="2" style="-fx-padding: 16 8 8 8;">
            <Label text="OVERVIEW"
                   style="-fx-text-fill: #8b949e;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-padding: 0 0 4 8;"/>

            <Button fx:id="btnNavDashboard" onAction="#handleNavDashboard"
                    prefWidth="200" text="  ≡  Dashboard"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavUserManagement" onAction="#handleNavUserManagement"
                    prefWidth="200" text="  👤  User Management"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavPlayers" onAction="#handleNavPlayers"
                    prefWidth="200" text="  🎮  Players"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavMatches" onAction="#handleNavMatches"
                    prefWidth="200" text="  ▶  Matches"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavTeams" onAction="#handleNavTeams"
                    prefWidth="200" text="  ◆  Teams"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavTournaments" onAction="#handleNavTournaments"
                    prefWidth="200" text="  🏆  Tournaments"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavCommunityHub" onAction="#handleNavCommunityHub"
                    prefWidth="200" text="  🌐  Community Hub"
                    style="-fx-background-color: #1f6feb22;
                           -fx-text-fill: #1f6feb;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-color: #1f6feb;
                           -fx-border-radius: 7;
                           -fx-border-width: 0 0 0 3;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavProductShop" onAction="#handleNavProductShop"
                    prefWidth="200" text="  🛒  Product Shop"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavSponsor" onAction="#handleNavSponsor"
                    prefWidth="200" text="  ⭐  Sponsor"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>
        </VBox>

        <!-- ADMIN TOOLS SECTION -->
        <VBox spacing="2" style="-fx-padding: 0 8 8 8;">
            <Separator style="-fx-background-color: #30363d;"/>
            <Label text="ADMIN TOOLS"
                   style="-fx-text-fill: #8b949e;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-padding: 8 0 4 8;"/>

            <Button fx:id="btnNavReports" onAction="#handleNavReports"
                    prefWidth="200" text="  📊  Reports"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavSettings" onAction="#handleNavSettings"
                    prefWidth="200" text="  ⚙  Settings"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>
        </VBox>

        <!-- SPACER — pousse le profil tout en bas -->
        <Region VBox.vgrow="ALWAYS"/>

    </VBox>

    <!-- ═══════════════════════════ -->
    <!-- CONTENU PRINCIPAL          -->
    <!-- ═══════════════════════════ -->
    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
          spacing="16"
          style="-fx-background-color: #0d1117;
                 -fx-padding: 30 25 30 25;">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="3">
                <Label text="Administration — Community Hub"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #ffffff;"/>
                <Label text="Gestion des publications · CartixeSports"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #8b949e;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10">
                <TextField fx:id="searchAdminField"
                           promptText="🔍 Rechercher un post..."
                           style="-fx-control-inner-background: #161b22;
                                  -fx-text-fill: #ffffff;
                                  -fx-prompt-text-fill: #8b949e;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #30363d;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;
                                  -fx-padding: 8 12;
                                  -fx-font-size: 12px;
                                  -fx-pref-width: 220;"/>
            </HBox>
        </HBox>

        <Separator style="-fx-background-color: #30363d;"/>

        <!-- LISTE POSTS ADMIN -->
        <ScrollPane fx:id="adminScrollPane"
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent;
                           -fx-background-color: transparent;
                           -fx-border-color: transparent;">
            <VBox fx:id="adminPostsContainer"
                  spacing="12"
                  style="-fx-background-color: transparent;
                         -fx-padding: 2 3 10 3;"/>
        </ScrollPane>
    </VBox>

    <!-- ═══════════════════════════ -->
    <!-- SIDEBAR DROITE ADMIN        -->
    <!-- ═══════════════════════════ -->
    <VBox prefWidth="220" spacing="5"
          style="-fx-background-color: #161b22;
                 -fx-padding: 30 15 30 15;
                 -fx-border-color: #30363d;
                 -fx-border-width: 0 0 0 1;">

        <Label text="ADMIN"
               style="-fx-text-fill: #1f6feb;
                      -fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-padding: 0 0 10 8;"/>

        <Button fx:id="btnTousLesPosts" onAction="#handleTousLesPosts"
                prefWidth="190"
                text="📋  Tous les posts"
                style="-fx-background-color: #1f6feb22;
                       -fx-background-radius: 7;
                       -fx-padding: 10 12;
                       -fx-border-color: #1f6feb;
                       -fx-border-radius: 7;
                       -fx-border-width: 0 0 0 3;
                       -fx-alignment: CENTER_LEFT;
                       -fx-text-fill: #1f6feb;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;"/>

        <Button fx:id="btnUsersSignales" onAction="#handleUsersSignales"
                prefWidth="190"
                text="👤  Users signalés"
                style="-fx-background-color: transparent;
                       -fx-padding: 10 12;
                       -fx-background-radius: 7;
                       -fx-alignment: CENTER_LEFT;
                       -fx-text-fill: #8b949e;
                       -fx-font-size: 13px;
                       -fx-border-width: 0;"/>

        <Separator style="-fx-background-color: #30363d;"/>

        <Label text="STATISTIQUES"
               style="-fx-text-fill: #8b949e;
                      -fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-padding: 10 0 5 8;"/>

        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-padding: 8 12;">
            <Label text="📝" style="-fx-font-size: 14px;"/>
            <VBox spacing="2">
                <Label fx:id="totalPostsLabel" text="0"
                       style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Label text="Total posts"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-padding: 8 12;">
            <Label text="🚨" style="-fx-font-size: 14px;"/>
            <VBox spacing="2">
                <Label fx:id="totalSignalesLabel" text="0"
                       style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Label text="Posts signalés"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <Separator style="-fx-background-color: #30363d;"/>

        <Label text="MEMBRES"
               style="-fx-text-fill: #8b949e;
                      -fx-font-size: 11px;
                      -fx-font-weight: bold;
                      -fx-padding: 10 0 5 8;"/>

        <VBox fx:id="adminMembersContainer" spacing="4"
              style="-fx-padding: 4 8;"/>

        <Region VBox.vgrow="ALWAYS"/>

    </VBox>

</HBox>
