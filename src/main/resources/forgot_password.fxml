<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="650" prefWidth="1060" styleClass="root-pane"
            stylesheets="@login.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ForgetPasswordController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="52" spacing="10" styleClass="navbar">
            <padding><Insets left="24" right="24" /></padding>
            <ImageView fitHeight="63.0" fitWidth="73.0">
                <image><Image url="@logoteam.png" /></image>
            </ImageView>
            <Label styleClass="logo-text" text="Cartix" />
        </HBox>
    </top>

    <center>
        <StackPane>
            <Circle radius="150" styleClass="orb-1" translateX="185"
                    translateY="95" StackPane.alignment="TOP_LEFT" />
            <Circle radius="240" styleClass="orb-2" translateX="460"
                    translateY="120" StackPane.alignment="BOTTOM_LEFT" />

            <VBox alignment="CENTER">
                <VBox styleClass="card" maxWidth="420">
                    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

                    <!-- STEP 1: Enter Email -->
                    <VBox fx:id="stepEmail">
                        <Label styleClass="card-title" text="Forgot Password" />
                        <Region prefHeight="6" />
                        <Label styleClass="card-sub"
                               text="Enter your email to receive a reset code." />
                        <Region prefHeight="20" />
                        <Label styleClass="field-label" text="Email address" />
                        <Region prefHeight="6" />
                        <TextField fx:id="emailField" maxWidth="Infinity"
                                   promptText="you@example.com"
                                   styleClass="input-field" />
                        <Region prefHeight="20" />
                        <Button maxWidth="Infinity" onAction="#handleSendCode"
                                styleClass="btn-signin" text="Send Reset Code" />
                        <Region prefHeight="12" />
                        <Button maxWidth="Infinity" onAction="#handleBackToLogin"
                                styleClass="link-btn" text="Back to Login" />
                    </VBox>

                    <!-- STEP 2: Enter Code -->
                    <VBox fx:id="stepCode" visible="false" managed="false">
                        <Label styleClass="card-title" text="Enter Reset Code" />
                        <Region prefHeight="6" />
                        <Label fx:id="codeSubLabel" styleClass="card-sub"
                               text="We sent a code to your email." />
                        <Region prefHeight="20" />
                        <Label styleClass="field-label" text="Reset Code" />
                        <Region prefHeight="6" />
                        <TextField fx:id="codeField" maxWidth="Infinity"
                                   promptText="Enter 6-digit code"
                                   styleClass="input-field" />
                        <Region prefHeight="20" />
                        <Button maxWidth="Infinity" onAction="#handleVerifyCode"
                                styleClass="btn-signin" text="Verify Code" />
                        <Region prefHeight="12" />
                        <Button maxWidth="Infinity" onAction="#handleBackToEmail"
                                styleClass="link-btn" text="Back" />
                    </VBox>

                    <!-- STEP 3: New Password -->
                    <VBox fx:id="stepNewPassword" visible="false" managed="false">
                        <Label styleClass="card-title" text="New Password" />
                        <Region prefHeight="6" />
                        <Label styleClass="card-sub"
                               text="Enter your new password." />
                        <Region prefHeight="20" />
                        <Label styleClass="field-label" text="New Password" />
                        <Region prefHeight="6" />
                        <PasswordField fx:id="newPasswordField" maxWidth="Infinity"
                                       promptText="Enter new password"
                                       styleClass="input-field" />
                        <Region prefHeight="12" />
                        <Label styleClass="field-label" text="Confirm Password" />
                        <Region prefHeight="6" />
                        <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity"
                                       promptText="Confirm new password"
                                       styleClass="input-field" />
                        <Region prefHeight="20" />
                        <Button maxWidth="Infinity" onAction="#handleResetPassword"
                                styleClass="btn-signin" text="Reset Password" />
                        <Region prefHeight="12" />
                        <Button maxWidth="Infinity" onAction="#handleBackToEmail"
                                styleClass="link-btn" text="Back" />
                    </VBox>

                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>