<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="960" prefWidth="1440" style="-fx-background-color: #0F0F17;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PlayersController">

    <!-- ======================== SIDEBAR ======================== -->
    <VBox prefHeight="960" prefWidth="220" style="-fx-background-color: #141420; -fx-padding: 20 0;">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 20 20 20;">
            <ImageView fitHeight="60.0" fitWidth="68.0">
                <image>
                    <Image url="@logoteam.png" />
                </image>
            </ImageView>
            <Label style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Cartix" />
        </HBox>
        <VBox spacing="4" style="-fx-padding: 12 8;">
            <Button onAction="#navDashboard" prefHeight="34" prefWidth="204" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 20;" text="Dashboard" />
            <Button onAction="#navPlayers" prefHeight="34" prefWidth="204" style="-fx-background-color: rgba(56,143,255,0.13); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 20; -fx-border-color: transparent transparent transparent #388FFF; -fx-border-width: 0 0 0 3;" text="Players" />
            <Button onAction="#navMatches" prefHeight="34" prefWidth="204" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 20;" text="Matches" />
            <Button onAction="#navTeams" prefHeight="34" prefWidth="204" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 20;" text="Teams" />
            <Button onAction="#navTournaments" prefHeight="34" prefWidth="204" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 20;" text="Tournaments" />
            <Button onAction="#navAnalytics" prefHeight="34" prefWidth="204" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 20;" text="Analytics" />
            <Button fx:id="btnNavProduit" onAction="#navProduits" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Produit" />
            <Button fx:id="btnNavSponsor" onAction="#navSponsors" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Sponsor" />
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #1C1C29; -fx-background-radius: 10; -fx-padding: 8 12;">
            <Label fx:id="userAvatarLabel" style="-fx-background-color: #8F3FFF; -fx-background-radius: 16; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-min-width: 32; -fx-min-height: 32; -fx-alignment: center;" text="IT" />
            <VBox>
                <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="test" />
                <Label fx:id="userRoleLabel" style="-fx-text-fill: #949499; -fx-font-size: 10px;" text="Pro Member" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ======================== MAIN CONTENT ======================== -->
    <HBox spacing="20" style="-fx-padding: 24 28;" HBox.hgrow="ALWAYS">

        <!-- LEFT: Players Table (Style Carte Login Moderne) -->
        <VBox style="-fx-background-color: #1C1C29; -fx-background-radius: 20; -fx-border-color: #2E2E44; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

            <!-- En-tête carte -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-text-fill: #388FFF; -fx-font-size: 24px;" text="👥" />
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Players Ranking" />
                <Label style="-fx-background-color: #2DFF9F20; -fx-text-fill: #2DFF9F; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 2 8;" text="SEASON 2025" />
            </HBox>

            <Separator style="-fx-background-color: #2E2E44; -fx-padding: 8 0;" />

            <!-- Barre de recherche -->
            <TextField fx:id="searchField" onKeyReleased="#onSearch" prefHeight="36" promptText="Search player..."
                       style="-fx-background-color: #0F0F17; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-color: #2E2E44; -fx-border-radius: 8; -fx-padding: 0 12; -fx-font-size: 12px;" />

            <!-- Filtres -->
            <HBox spacing="8">
                <ComboBox fx:id="filterGameCombo" prefWidth="110" promptText="Game" style="-fx-background-color: #0F0F17; -fx-text-fill: white; -fx-background-radius: 6;" />
                <ComboBox fx:id="filterRegionCombo" prefWidth="100" promptText="Region" style="-fx-background-color: #0F0F17; -fx-text-fill: white; -fx-background-radius: 6;" />
                <ComboBox fx:id="filterRankCombo" prefWidth="120" promptText="Rank" style="-fx-background-color: #0F0F17; -fx-text-fill: white; -fx-background-radius: 6;" />
            </HBox>

            <!-- Tableau moderne -->
            <TableView fx:id="playersTable" style="-fx-background-color: transparent; -fx-background-radius: 12;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRank" prefWidth="50" text="#" style="-fx-text-fill: #5A5A7A;" />
                    <TableColumn fx:id="colName" prefWidth="160" text="PLAYER" style="-fx-text-fill: #5A5A7A;" />
                    <TableColumn fx:id="colTeam" prefWidth="130" text="TEAM" style="-fx-text-fill: #5A5A7A;" />
                    <TableColumn fx:id="colGame" prefWidth="90" text="GAME" style="-fx-text-fill: #5A5A7A;" />
                    <TableColumn fx:id="colKills" prefWidth="70" text="KILLS" style="-fx-text-fill: #2DFF9F;" />
                    <TableColumn fx:id="colDeaths" prefWidth="70" text="DEATHS" style="-fx-text-fill: #FF4D6A;" />
                    <TableColumn fx:id="colAssists" prefWidth="70" text="ASSISTS" style="-fx-text-fill: #388FFF;" />
                    <TableColumn fx:id="colKDA" prefWidth="70" text="KDA" style="-fx-text-fill: #FFB830;" />
                    <TableColumn fx:id="colWR" prefWidth="80" text="WIN RATE" style="-fx-text-fill: #5A5A7A;" />
                    <TableColumn fx:id="colStatus" prefWidth="80" text="STATUS" style="-fx-text-fill: #5A5A7A;" />
                    <TableColumn fx:id="colFavorite" prefWidth="50" text="★" style="-fx-text-fill: #FFD700;" />
                </columns>
            </TableView>

            <!-- Pied de carte -->
            <HBox alignment="CENTER" spacing="10" style="-fx-padding: 12 0 0 0;">
                <Label style="-fx-text-fill: #949499; -fx-font-size: 11px;" text="Showing all players" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#showTopWinRate" style="-fx-background-color: #388FFF; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 6; -fx-padding: 5 12;" text="Top Win Rate" />
            </HBox>
        </VBox>

        <!-- RIGHT: Friends Panel -->
        <VBox prefWidth="280" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Friends" />
                <Label fx:id="friendCountLabel" style="-fx-text-fill: #949499; -fx-font-size: 11px;" text="0 friends" />
            </HBox>

            <HBox spacing="6">
                <TextField fx:id="searchFriendField" prefHeight="32" prefWidth="200" promptText="Search player..." style="-fx-background-color: #1C1C29; -fx-text-fill: white; -fx-background-radius: 6; -fx-border-color: #2E2E44; -fx-border-radius: 6; -fx-padding: 0 10; -fx-font-size: 11px;" />
                <Button onAction="#sendFriendRequest" prefHeight="32" style="-fx-background-color: #388FFF; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 0 10;" text="Add" />
            </HBox>

            <Separator style="-fx-background-color: #2E2E44;" />

            <!-- Friend Requests Section -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-text-fill: #FFB830; -fx-font-size: 12px; -fx-font-weight: bold;" text="Friend Requests" />
                    <Label fx:id="requestCountLabel" style="-fx-text-fill: #949499; -fx-font-size: 10px;" text="0 pending" />
                </HBox>
                <ScrollPane fitToWidth="true" prefHeight="180" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #2E2E44; -fx-border-radius: 8;">
                    <VBox fx:id="friendRequestsBox" spacing="6" style="-fx-padding: 8;" />
                </ScrollPane>
            </VBox>

            <Separator style="-fx-background-color: #2E2E44;" />

            <!-- Friends List -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-text-fill: #2DFF9F; -fx-font-size: 12px; -fx-font-weight: bold;" text="My Friends" />
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #2E2E44; -fx-border-radius: 8;">
                    <VBox fx:id="friendsListBox" spacing="6" style="-fx-padding: 8;" />
                </ScrollPane>
            </VBox>
        </VBox>
    </HBox>
</HBox>