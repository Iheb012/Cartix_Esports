<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="960" prefWidth="1440" style="-fx-background-color: #0F0F17;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController">

    <!-- ═══════════════════════════════════════════════ SIDEBAR ══ -->
    <VBox prefHeight="960" prefWidth="200" style="-fx-background-color: #141420; -fx-padding: 16 0 0 0;">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 16 16 16;">
         <ImageView fitHeight="67.0" fitWidth="60.0">
            <image>
               <Image url="logoteam.png" />
            </image>
         </ImageView>
            <Label style="-fx-text-fill: white; -fx-font-size: 14px;                           -fx-font-weight: bold; -fx-letter-spacing: 1px;" text="Cartix" />
        </HBox>

        <!-- Nav items -->
        <VBox fx:id="navBox" spacing="2" style="-fx-padding: 0 8;">
            <Button fx:id="btnNavDashboard" onAction="#navDashboard" prefHeight="36" prefWidth="184" style="-fx-background-color: rgba(56,143,255,0.13); -fx-text-fill: white;                            -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 14;                            -fx-border-color: transparent transparent transparent #388FFF;                            -fx-border-width: 0 0 0 3;" text="Dashboard" />
            <Button fx:id="btnNavPlayers" onAction="#navPlayers" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Players" />
            <Button fx:id="btnNavMatches" onAction="#navMatches" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Matches" />
            <Button fx:id="btnNavTeams" onAction="#navTeams" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Teams" />
            <Button fx:id="btnNavTournaments" onAction="#navTournaments" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Tournaments" />
            <Button fx:id="btnNavAnalytics" onAction="#navAnalytics" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Analytics" />
            <Button fx:id="btnNavProduit" onAction="#navProduits" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Produit" />
            <Button fx:id="btnNavSponsor" onAction="#navSponsors" prefHeight="36" prefWidth="184" style="-fx-background-color: transparent; -fx-text-fill: #949499;                            -fx-font-size: 13px; -fx-alignment: CENTER_LEFT;                            -fx-background-radius: 8; -fx-padding: 0 0 0 17;" text="Sponsor" />
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- User profile card -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #1C1C29; -fx-background-radius: 10;                      -fx-padding: 8 10; -fx-margin: 0 12 12 12;">
            <Label style="-fx-background-color: #8F3FFF; -fx-background-radius: 16;                           -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;                           -fx-min-width: 32; -fx-min-height: 32; -fx-alignment: center;" text="T" />
            <VBox spacing="1">
                <Label style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" text="test" />
                <Label style="-fx-text-fill: #949499; -fx-font-size: 10px;" text="Pro Member" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ══════════════════════════════════════ MAIN CONTENT ══ -->
    <VBox style="-fx-padding: 20 24;" HBox.hgrow="ALWAYS">

        <!-- Top header row -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
            <VBox>
                <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Dashboard" />
                <Label style="-fx-text-fill: #949499; -fx-font-size: 12px;" text="Pick a game to explore live tournaments, news &amp; trends" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10">
                <TextField prefHeight="34" prefWidth="200" promptText="Search..." style="-fx-background-color: #1C1C29; -fx-text-fill: white;                                   -fx-background-radius: 8; -fx-border-color: #2E2E44;                                   -fx-border-radius: 8; -fx-padding: 0 12; -fx-font-size: 12px;" />
                <!-- Icon buttons (users / bell) -->
                <Button prefHeight="34" prefWidth="34" style="-fx-background-color: #1C1C29; -fx-text-fill: white;                                -fx-background-radius: 8; -fx-border-color: #2E2E44;                                -fx-border-radius: 8; -fx-font-size: 14px;" text="👥" />
                <Button prefHeight="34" prefWidth="34" style="-fx-background-color: #1C1C29; -fx-text-fill: white;                                -fx-background-radius: 8; -fx-border-color: #2E2E44;                                -fx-border-radius: 8; -fx-font-size: 14px;" text="🔔" />
            </HBox>
        </HBox>

        <!-- Popular games label -->
        <Label style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                       -fx-padding: 0 0 8 0;" text="Popular games" />

        <!-- Game selector bar -->
        <HBox fx:id="gameSelectorBar" spacing="10" style="-fx-padding: 0 0 18 0;">
            <Button fx:id="btnValorant" onAction="#onGameSelected" prefHeight="60" prefWidth="175" style="-fx-background-color: #1C1C29; -fx-background-radius: 12;                            -fx-border-color: #E04444; -fx-border-radius: 12; -fx-cursor: hand;" text="Valorant" textFill="RED" userData="Valorant" />
            <Button fx:id="btnCS2" onAction="#onGameSelected" prefHeight="60" prefWidth="175" style="-fx-background-color: #1C1C29; -fx-background-radius: 12; -fx-cursor: hand;" text="CS2" textFill="#e6ff25" userData="CS2" />
            <Button fx:id="btnLoL" onAction="#onGameSelected" prefHeight="60" prefWidth="175" style="-fx-background-color: #1C1C29; -fx-background-radius: 12; -fx-cursor: hand;" text="League Of Legends" textFill="#0099ff" userData="LoL" />
            <Button fx:id="btnDota2" onAction="#onGameSelected" prefHeight="60" prefWidth="175" style="-fx-background-color: #1C1C29; -fx-background-radius: 12; -fx-cursor: hand;" text="Dota2" textFill="#fb00ff" userData="Dota2" />
            <Button fx:id="btnFortnite" onAction="#onGameSelected" prefHeight="60" prefWidth="175" style="-fx-background-color: #1C1C29; -fx-background-radius: 12; -fx-cursor: hand;" text="Fortnite" textFill="#08ff15" userData="Fortnite" />
            <Button fx:id="btnApex" onAction="#onGameSelected" prefHeight="60" prefWidth="175" style="-fx-background-color: #1C1C29; -fx-background-radius: 12; -fx-cursor: hand;" text="Apex" textAlignment="CENTER" textFill="#ff8c00" userData="Apex" />
        </HBox>

        <!-- ── Content row: left feed + right voice panel ── -->
        <HBox spacing="18" VBox.vgrow="ALWAYS">

            <!-- ── LEFT COLUMN ── -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;                                -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
                <VBox spacing="14">

                    <!-- Live tournaments -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="liveTourneyTitle" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Live tournaments — Valorant" />
                            <Label style="-fx-background-color: rgba(242,51,51,0.18);                                           -fx-text-fill: #F23333; -fx-font-size: 9px; -fx-font-weight: bold;                                           -fx-background-radius: 4; -fx-padding: 3 8;" text="LIVE" />
                        </HBox>
                  <ImageView fitHeight="77.0" fitWidth="631.0">

                  </ImageView>
                        <VBox fx:id="liveTourneysBox" spacing="8" />
                  <ImageView fitHeight="77.0" fitWidth="631.0">

                  </ImageView>
                  <ImageView fitHeight="77.0" fitWidth="631.0">

                  </ImageView>
                    </VBox>

                    <!-- Latest news -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Latest news" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Hyperlink style="-fx-text-fill: #388FFF; -fx-border-color: transparent; -fx-font-size: 12px;" text="View all →" />
                        </HBox>
                  <ImageView fitHeight="47.0" fitWidth="630.0">

                  </ImageView>
                        <VBox fx:id="newsBox" spacing="8" />
                  <ImageView fitHeight="47.0" fitWidth="630.0">

                  </ImageView>
                  <ImageView fitHeight="47.0" fitWidth="630.0">

                  </ImageView>
                    </VBox>

                    <!-- Trending now -->
                    <VBox spacing="8">
                        <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Trending now" />
                        <HBox fx:id="trendsBox" spacing="10" />
                  <ImageView fitHeight="63.0" fitWidth="200.0">

                  </ImageView>
                    </VBox>

                    <!-- Community memes -->
                    <VBox spacing="8">
                        <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Community memes &amp; highlights" />
                        <HBox fx:id="memesBox" spacing="10" />
                  <ImageView fitHeight="112.0" fitWidth="200.0">

                  </ImageView>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- ── RIGHT COLUMN: Voice chat room ── -->
            <VBox prefWidth="310" spacing="0" style="-fx-background-color: #12122A; -fx-background-radius: 14;                          -fx-border-color: #2A2A40; -fx-border-radius: 14; -fx-border-width: 1;                          -fx-padding: 0 0 0 0;">

                <!-- Room header -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #1A1A30; -fx-background-radius: 14 14 0 0;                              -fx-padding: 14 14 14 14;">
                    <Label style="-fx-text-fill: #38D68A; -fx-font-size: 12px;" text="●" />
                    <Label fx:id="roomNameLabel" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="ROOM NAME" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button style="-fx-background-color: #2E2E4A; -fx-text-fill: #949499;                                    -fx-background-radius: 6; -fx-font-size: 14px;                                    -fx-min-width: 28; -fx-min-height: 28; -fx-cursor: hand;" text="＋" />
                    <Button style="-fx-background-color: #2E2E4A; -fx-text-fill: #949499;                                    -fx-background-radius: 6; -fx-font-size: 14px;                                    -fx-min-width: 28; -fx-min-height: 28; -fx-cursor: hand;" text="⚙" />
                </HBox>

                <!-- Room name tabs -->
                <HBox spacing="8" style="-fx-padding: 8 14; -fx-background-color: #1A1A30;">
                    <Button style="-fx-background-color: #252540; -fx-text-fill: white;                                    -fx-background-radius: 6; -fx-font-size: 11px;                                    -fx-padding: 4 10; -fx-cursor: hand;" text="Room name" />
                    <Button style="-fx-background-color: transparent; -fx-text-fill: #949499;                                    -fx-background-radius: 6; -fx-font-size: 11px;                                    -fx-padding: 4 10; -fx-cursor: hand;" text="tournament" />
                </HBox>

                <!-- Player list -->
                <VBox fx:id="voicePlayersBox" spacing="0" VBox.vgrow="ALWAYS" />

                <!-- Volume control -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 14; -fx-background-color: #1A1A30;">
                    <Label style="-fx-text-fill: #949499; -fx-font-size: 11px;" text="Volume" />
                    <Slider fx:id="volumeSlider" max="100" min="0" style="-fx-accent: #388FFF;" value="75" HBox.hgrow="ALWAYS" />
                    <Label fx:id="volumeLabel" style="-fx-text-fill: white; -fx-font-size: 11px; -fx-min-width: 32;" text="75%" />
                </HBox>

                <!-- YOU row -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #1A1A30; -fx-background-radius: 0 0 14 14;                              -fx-padding: 10 14; -fx-border-color: #252540 transparent transparent transparent;                              -fx-border-width: 1 0 0 0;">
                    <Label style="-fx-background-color: #888; -fx-background-radius: 20;                                   -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;                                   -fx-min-width: 38; -fx-min-height: 38; -fx-alignment: center;" text="Y" />
                    <VBox spacing="1">
                        <Label style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" text="YOU" />
                        <Label style="-fx-text-fill: #38D68A; -fx-font-size: 10px;" text="speaking" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button style="-fx-background-color: #252540; -fx-text-fill: white;                                    -fx-background-radius: 8; -fx-min-width: 32; -fx-min-height: 32;                                    -fx-font-size: 14px; -fx-cursor: hand;" text="🎙" />
                    <Button style="-fx-background-color: #252540; -fx-text-fill: white;                                    -fx-background-radius: 8; -fx-min-width: 32; -fx-min-height: 32;                                    -fx-font-size: 14px; -fx-cursor: hand;" text="🎧" />
                    <Button style="-fx-background-color: #388FFF; -fx-text-fill: white;                                    -fx-background-radius: 8; -fx-min-width: 32; -fx-min-height: 32;                                    -fx-font-size: 14px; -fx-cursor: hand;" text="↗" />
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</HBox>
