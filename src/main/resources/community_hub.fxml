<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.CommunityHubController"
      prefHeight="960.0" prefWidth="1280.0"
      style="-fx-background-color: #0d1117;">

    <!-- ═══════════════════════════ -->
    <!-- SIDEBAR NAVIGATION GAUCHE  -->
    <!-- ═══════════════════════════ -->
    <VBox prefWidth="220"
          style="-fx-background-color: #161b22;
                 -fx-padding: 0 0 30 0;
                 -fx-border-color: #30363d;
                 -fx-border-width: 0 1 0 0;">

        <!-- LOGO / APP NAME -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 22 16 22 16;
                     -fx-border-color: #30363d;
                     -fx-border-width: 0 0 1 0;">
            <Label text="🏆 CartixeSports"
                   style="-fx-text-fill: #1f6feb;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <!-- NAV ITEMS -->
        <VBox spacing="2" style="-fx-padding: 12 8 12 8;">

            <Button fx:id="btnNavDashboard" onAction="#handleNavDashboard"
                    prefWidth="200" text="  Dashboard"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavPlayers" onAction="#handleNavPlayers"
                    prefWidth="200" text=" Players"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavMatches" onAction="#handleNavMatches"
                    prefWidth="200" text="Matches"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavTeams" onAction="#handleNavTeams"
                    prefWidth="200" text="Teams"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavTournaments" onAction="#handleNavTournaments"
                    prefWidth="200" text="Tournaments"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <!-- ACTIVE: Community Hub -->
            <Button fx:id="btnNavCommunityHub" onAction="#handleNavCommunityHub"
                    prefWidth="200" text="Community Hub"
                    style="-fx-background-color: #1f6feb22;
                           -fx-text-fill: #1f6feb;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-color: #1f6feb;
                           -fx-border-radius: 7;
                           -fx-border-width: 0 0 0 3;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavProductShop" onAction="#handleNavProductShop"
                    prefWidth="200" text=" Product Shop"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnNavSponsor" onAction="#handleNavSponsor"
                    prefWidth="200" text=" Sponsor"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #8b949e;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-alignment: CENTER_LEFT;
                           -fx-padding: 10 14;
                           -fx-border-width: 0;
                           -fx-cursor: hand;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- USER CARD -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color: #21262d;
                     -fx-padding: 10 12;
                     -fx-background-radius: 8;
                     -fx-border-color: #30363d;
                     -fx-border-radius: 8;
                     -fx-border-width: 1;
                     -fx-margin: 0 8 0 8;">
            <Label text="👤"
                   style="-fx-background-color: #1f6feb;
                          -fx-background-radius: 50;
                          -fx-font-size: 14px;
                          -fx-padding: 4 7;"/>
            <VBox spacing="1">
                <Label text="Anaghim"
                       style="-fx-text-fill: #ffffff;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;"/>
                <Label text="En ligne"
                       style="-fx-text-fill: #3fb950;
                              -fx-font-size: 10px;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════ -->
    <!-- FEED CENTRAL               -->
    <!-- ═══════════════════════════ -->
    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
          spacing="16"
          style="-fx-background-color: #0d1117;
                 -fx-padding: 30 25 30 25;">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox spacing="3">
                <Label text="Community Hub"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #ffffff;"/>
                <Label text="Season 2026 · CartixeSports"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #8b949e;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="20">
                <VBox alignment="CENTER" spacing="2">
                    <Label fx:id="memberCountLabel" text="0"
                           style="-fx-text-fill: #ffffff;
                                  -fx-font-weight: bold;
                                  -fx-font-size: 16px;"/>
                    <Label text="Membres"
                           style="-fx-text-fill: #8b949e;
                                  -fx-font-size: 10px;"/>
                </VBox>
                <Separator orientation="VERTICAL"
                           style="-fx-background-color: #30363d;"/>
                <VBox alignment="CENTER" spacing="2">
                    <Label fx:id="postCountLabel"
                           text="0"
                           style="-fx-text-fill: #ffffff;
                                  -fx-font-weight: bold;
                                  -fx-font-size: 16px;"/>
                    <Label text="Posts"
                           style="-fx-text-fill: #8b949e;
                                  -fx-font-size: 10px;"/>
                </VBox>
                <Separator orientation="VERTICAL"
                           style="-fx-background-color: #30363d;"/>
                <HBox alignment="CENTER" spacing="4">
                    <Label text="●"
                           style="-fx-text-fill: #2ea043;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 14px;"/>
                    <Label text="Actif"
                           style="-fx-text-fill: #8b949e;
                                   -fx-font-size: 14px;"/>
                </HBox>
                <StackPane>
                    <Label text="🔔"
                           fx:id="bellIcon"
                           style="-fx-font-size: 18px; -fx-cursor: hand;"/>
                    <Label fx:id="notificationBadge"
                           text="0"
                           style="-fx-background-color: #e74c3c;
                                  -fx-text-fill: white;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-background-radius: 10;
                                  -fx-min-width: 18;
                                  -fx-min-height: 14;
                                  -fx-alignment: center;
                                  -fx-padding: 0 4;
                                  -fx-translate-x: 8;
                                  -fx-translate-y: -8;"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>
            </HBox>
        </HBox>

        <Separator style="-fx-background-color: #30363d;"/>

        <!-- ZONE DE PUBLICATION -->
        <VBox spacing="10"
              style="-fx-background-color: #161b22;
                     -fx-padding: 18;
                     -fx-background-radius: 10;
                     -fx-border-color: #30363d;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;">

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="👤"
                       style="-fx-background-color: #1f6feb;
                              -fx-background-radius: 50;
                              -fx-font-size: 16px;
                              -fx-padding: 5 9;"/>
                <TextArea fx:id="postInput"
                          promptText="Partage quelque chose avec la communauté..."
                          prefHeight="70"
                          wrapText="true"
                          HBox.hgrow="ALWAYS"
                          style="-fx-control-inner-background: #0d1117;
                                 -fx-text-fill: #ffffff;
                                 -fx-prompt-text-fill: #8b949e;
                                 -fx-font-size: 13px;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #30363d;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 10;"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="charCount"
                       text="0 / 280"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
                <Button fx:id="btnPublish"
                        text="Publier →"
                        onAction="#handlePublish"
                        style="-fx-background-color: #1f6feb;
                               -fx-text-fill: #ffffff;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-background-radius: 7;
                               -fx-padding: 8 20;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- BOUTONS DE NAVIGATION -->
        <HBox spacing="8">
            <Button fx:id="btnFeed" text="🏠 Feed" onAction="#handleFeed" style="-fx-background-color: #1f6feb; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-border-width: 0; -fx-cursor: hand;"/>
            <Button fx:id="btnTendances" text="🔥 Tendances" onAction="#handleTendances" style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-border-width: 0; -fx-cursor: hand;"/>
            <Button fx:id="btnTopPosts" text="⭐ Top Posts" onAction="#handleTopPosts" style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-border-width: 0; -fx-cursor: hand;"/>
            <Button fx:id="btnMesPosts" text="📝 Mes Posts" onAction="#handleMesPosts" style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-border-width: 0; -fx-cursor: hand;"/>
            <Button fx:id="btnChat" text="💬 Chat" onAction="#handleChat" style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 18; -fx-border-width: 0; -fx-cursor: hand;"/>
        </HBox>

        <!-- ZONE MESSAGES -->
        <VBox fx:id="messagesContainer"
              spacing="0"
              VBox.vgrow="ALWAYS"
              managed="false"
              visible="false"
              style="-fx-background-color: #161b22;
                     -fx-background-radius: 10;
                     -fx-border-color: #30363d;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;">

            <Label text="💬 Messages"
                   style="-fx-text-fill: #ffffff;
                          -fx-font-size: 16px;
                          -fx-font-weight: bold;
                          -fx-padding: 12 16;
                          -fx-border-color: #30363d;
                          -fx-border-width: 0 0 1 0;"/>

            <ScrollPane VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        style="-fx-background: #161b22;
                               -fx-background-color: #161b22;
                               -fx-border-color: transparent;">
                <HBox minHeight="400">
                    <VBox fx:id="roomsSidebar"
                      prefWidth="155" spacing="4"
                      style="-fx-background-color: #0d1117;
                             -fx-padding: 12 8;
                             -fx-border-color: #30363d;
                             -fx-border-width: 0 1 0 0;">

                    <Label text="SALONS"
                           style="-fx-text-fill: #8b949e;
                                  -fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 0 0 6 4;"/>

                    <Button fx:id="btnGeneral" text="#  général" onAction="#handleRoomGeneral" prefWidth="135" style="-fx-background-color: #1f6feb22; -fx-text-fill: #1f6feb; -fx-font-size: 13px; -fx-background-radius: 6; -fx-alignment: CENTER_LEFT; -fx-padding: 8 10; -fx-border-width: 0; -fx-cursor: hand;"/>
                    <Button fx:id="btnTournois" text="#  tournois" onAction="#handleRoomTournois" prefWidth="135" style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-background-radius: 6; -fx-alignment: CENTER_LEFT; -fx-padding: 8 10; -fx-border-width: 0; -fx-cursor: hand;"/>
                    <Button fx:id="btnAmis" text="👥  amis" onAction="#handleRoomAmis" prefWidth="135" style="-fx-background-color: transparent; -fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-background-radius: 6; -fx-alignment: CENTER_LEFT; -fx-padding: 8 10; -fx-border-width: 0; -fx-cursor: hand;"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="activeRoomLabel"
                           text="# général"
                           style="-fx-text-fill: #ffffff;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 10 15;
                                  -fx-border-color: #30363d;
                                  -fx-border-width: 0 0 1 0;
                                  -fx-background-color: #161b22;
                                  -fx-max-width: Infinity;"/>
                    <ScrollPane fx:id="messagesScrollPane"
                                VBox.vgrow="ALWAYS"
                                fitToWidth="true"
                                style="-fx-background: transparent;
                                       -fx-background-color: transparent;
                                       -fx-border-color: transparent;">
                        <VBox fx:id="messagesList"
                              spacing="8"
                              style="-fx-padding: 10 15;
                                     -fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </HBox>
            </ScrollPane>

            <!-- BARRE DE SAISIE CHAT -->
            <HBox fx:id="messageInputBar"
                  spacing="8"
                  alignment="CENTER"
                  minHeight="60"
                  maxHeight="60"
                  managed="false"
                  visible="false"
                  style="-fx-padding: 10 15;
                         -fx-border-color: #30363d;
                         -fx-border-width: 1 0 0 0;
                         -fx-background-color: #21262d;">

                <TextField fx:id="messageInputField"
                           promptText="Écrire un message..."
                           HBox.hgrow="ALWAYS"
                           onAction="#handleSendMessage"
                           style="-fx-control-inner-background: #0d1117;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #8b949e;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #30363d;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;
                                  -fx-padding: 10 12;
                                  -fx-font-size: 13px;"/>

                <Button text="➤ Envoyer"
                        onAction="#handleSendMessage"
                        style="-fx-background-color: #1f6feb;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 9 18;
                               -fx-border-width: 0;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <!-- LISTE POSTS -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent;
                           -fx-background-color: transparent;
                           -fx-border-color: transparent;">
            <VBox fx:id="postsContainer"
                  spacing="12"
                  style="-fx-background-color: transparent;
                         -fx-padding: 2 3 10 3;"/>
        </ScrollPane>
    </VBox>

    <!-- SIDEBAR DROITE -->
    <VBox prefWidth="260" spacing="16"
          style="-fx-background-color: #161b22;
                 -fx-padding: 30 16 30 16;
                 -fx-border-color: #30363d;
                 -fx-border-width: 0 0 0 1;">

        <TextField fx:id="searchField"
                   promptText="🔍  Rechercher..."
                   style="-fx-control-inner-background: #0d1117;
                          -fx-text-fill: #ffffff;
                          -fx-prompt-text-fill: #8b949e;
                          -fx-background-radius: 8;
                          -fx-border-color: #30363d;
                          -fx-border-radius: 8;
                          -fx-border-width: 1;
                          -fx-padding: 9 12;
                          -fx-font-size: 13px;"/>

        <VBox spacing="8"
              style="-fx-background-color: #0d1117;
                     -fx-padding: 12;
                     -fx-background-radius: 8;
                     -fx-border-color: #30363d;
                     -fx-border-radius: 8;
                     -fx-border-width: 1;">
            <Label text="🗓 Recherche par date"
                   style="-fx-text-fill: #8b949e;
                          -fx-font-size: 11px;
                          -fx-font-weight: bold;"/>
            <TextField fx:id="searchDateField"
                       promptText="ex: 2026-05-11"
                       style="-fx-control-inner-background: #0d1117;
                              -fx-text-fill: #ffffff;
                              -fx-prompt-text-fill: #8b949e;
                              -fx-background-radius: 6;
                              -fx-border-color: #30363d;
                              -fx-border-radius: 6;
                              -fx-border-width: 1;
                              -fx-padding: 8 10;
                              -fx-font-size: 12px;"/>
            <Button text="🔍 Chercher"
                    onAction="#handleSearchByDate"
                    style="-fx-background-color: #1f6feb;
                           -fx-text-fill: white;
                           -fx-font-size: 12px;
                           -fx-background-radius: 6;
                           -fx-padding: 7 12;
                           -fx-border-width: 0;"/>
        </VBox>

        <VBox fx:id="topMembersContainer" spacing="10"
              style="-fx-background-color: #0d1117;
                     -fx-padding: 16;
                     -fx-background-radius: 10;
                     -fx-border-color: #30363d;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;">
            <Label text="🏆  Membres"
                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #ffffff;"/>
            <Separator style="-fx-background-color: #30363d;"/>
        </VBox>

        <VBox spacing="8"
              style="-fx-background-color: #0d1117;
                     -fx-padding: 16;
                     -fx-background-radius: 10;
                     -fx-border-color: #30363d;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;">
            <Label text="📋  Règles"
                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #ffffff;"/>
            <Separator style="-fx-background-color: #30363d;"/>
            <Label text="✅  Respecte les membres" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
            <Label text="✅  Pas de langage offensant" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
            <Label text="✅  Pas de spam" style="-fx-text-fill: #8b949e; -fx-font-size: 12px;"/>
        </VBox>

    </VBox>

</HBox>
